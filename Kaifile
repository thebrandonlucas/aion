environment roc {
  packages: ["rocpkgs.nightly", "llvmPackages.bintools", "nix"]
  overlays: ["github:thebrandonlucas/roc-overlay"]
}

task format {
  environment: "roc"
  run: ["roc", "fmt", "plugins/aion/MachinePlugin.roc", "src/aion-init.roc"]
}

environment cli {
  packages: ["rocpkgs.nightly", "llvmPackages.bintools", "openssh"]
  overlays: ["github:thebrandonlucas/roc-overlay"]
}

build aion {
  environment: cli
  source: "src/aion.roc"
  output: "aion"
}

build aion-init {
  environment: roc
  source: "src/aion-init.roc"
  output: "aion-init"
}

machine agent {
  system: "x86_64-linux"
  region: "nyc3"
  size: "s-2vcpu-4gb"
  provider: "ppq"
  model: "openai/gpt-5.1-codex"
  packages: ["git"]
}
