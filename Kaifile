source bitcoin-qr {
  url: "tarball+https://registry.npmjs.org/bitcoin-qr/-/bitcoin-qr-1.4.1.tgz"
}

environment roc {
  packages: ["rocpkgs.nightly", "llvmPackages.bintools", "nix"]
  overlays: ["github:thebrandonlucas/roc-overlay"]
}

task format {
  environment: "roc"
  run: ["roc", "fmt", "src/aion-run.roc", "src/aion-web.roc", "src/aion.roc", "src/AionState.roc", "src/Ansi.roc", "src/DigitalOcean.roc", "src/DigitalOceanApi.roc", "src/Everpaid.roc", "src/EverpaidApi.roc", "src/SshKey.roc"]
}

environment cli {
  packages: ["rocpkgs.nightly", "llvmPackages.bintools", "bashInteractive", "openssh", "coreutils", "rsync", "awscli2", "nix", "nixos-rebuild"]
  overlays: ["github:thebrandonlucas/roc-overlay"]
}

build aion {
  environment: cli
  run: ["roc", "build", "src/aion.roc", "--opt=size", "--output=aion"]
  output: "aion"
}

build aion-run {
  environment: cli
  run: ["roc", "build", "src/aion-run.roc", "--opt=size", "--output=aion-run"]
  output: "aion-run"
}

environment web {
  packages: ["rocpkgs.nightly", "llvmPackages.bintools", "openssh", "coreutils", "awscli2", "nix", "nixos-rebuild"]
  overlays: ["github:thebrandonlucas/roc-overlay"]
}

build aion-web {
  environment: web
  inputs: ["bitcoin-qr"]
  run: ["roc", "build", "src/aion-web.roc", "--opt=size", "--output=aion-web"]
  output: "aion-web"
}

task aion-shell {
  environment: "cli"
  run: [".kai/artifacts/builds/aion-run", "shell"]
}

task build-image {
  environment: "cli"
  run: [".kai/artifacts/builds/aion-run", "build-image"]
}

task import-image {
  environment: "cli"
  run: [".kai/artifacts/builds/aion-run", "import-image"]
}

task status {
  environment: "cli"
  run: [".kai/artifacts/builds/aion-run", "status"]
}

task resources {
  environment: "cli"
  run: [".kai/artifacts/builds/aion-run", "resources"]
}

task image-status {
  environment: "cli"
  run: [".kai/artifacts/builds/aion-run", "image-status"]
}

task image-reconcile {
  environment: "cli"
  run: [".kai/artifacts/builds/aion-run", "image-reconcile"]
}

task create-demo {
  environment: "cli"
  run: [".kai/artifacts/builds/aion-run", "create-demo"]
}

task shell-demo {
  environment: "cli"
  run: [".kai/artifacts/builds/aion-run", "shell-demo"]
}

task shell-pi-demo {
  environment: "cli"
  run: [".kai/artifacts/builds/aion-run", "shell-pi-demo"]
}

task check-demo {
  environment: "cli"
  run: [".kai/artifacts/builds/aion-run", "check-demo"]
}

task destroy-demo {
  environment: "cli"
  run: [".kai/artifacts/builds/aion-run", "destroy-demo"]
}

task delete-image {
  environment: "cli"
  run: [".kai/artifacts/builds/aion-run", "delete-image"]
}

task payment-preflight {
  environment: "web"
  run: [".kai/artifacts/builds/aion-run", "payment-preflight"]
}

task payment-server {
  environment: "web"
  run: [".kai/artifacts/builds/aion-run", "payment-server"]
}

environment base {
  packages: []
}

machine base {
  environment: base
  system: "x86_64-linux"
}

environment agent {
  packages: ["git", "pi-coding-agent"]
}

machine agent {
  environment: agent
  system: "x86_64-linux"
}

workflow aion-shell {
  steps: ["build aion", "build aion-run", "run aion-shell"]
}

workflow prepare {
  steps: ["build aion", "build aion-run", "run build-image"]
}

workflow import-image {
  steps: ["build aion", "build aion-run", "run build-image", "run import-image", "run image-status"]
}

workflow payment-demo {
  steps: ["build aion", "build aion-run", "build aion-web", "run payment-preflight", "run payment-server"]
}
