source bitcoin-qr {
  url: "tarball+https://registry.npmjs.org/bitcoin-qr/-/bitcoin-qr-1.4.1.tgz"
}

environment roc {
  packages: ["rocpkgs.nightly", "llvmPackages.bintools", "nix"]
  overlays: ["github:thebrandonlucas/roc-overlay"]
}

task format {
  environment: "roc"
  run: ["roc", "fmt", "plugins/aion/AionPlugin.roc", "src/aion-init.roc", "src/aion-run.roc", "src/aion-web.roc", "src/aion.roc", "src/AionState.roc", "src/Ansi.roc", "src/DigitalOcean.roc", "src/DigitalOceanApi.roc", "src/Everpaid.roc", "src/EverpaidApi.roc"]
}

environment cli {
  packages: ["rocpkgs.nightly", "llvmPackages.bintools", "bashInteractive", "openssh", "coreutils", "awscli2"]
  overlays: ["github:thebrandonlucas/roc-overlay"]
}

build aion {
  environment: cli
  source: "src/aion.roc"
  output: "aion"
}

build aion-run {
  environment: cli
  source: "src/aion-run.roc"
  output: "aion-run"
}

build aion-init {
  environment: roc
  source: "src/aion-init.roc"
  output: "aion-init"
}

environment web {
  packages: ["rocpkgs.nightly", "llvmPackages.bintools", "openssh", "coreutils", "awscli2"]
  overlays: ["github:thebrandonlucas/roc-overlay"]
}

build aion-web {
  environment: web
  inputs: ["bitcoin-qr"]
  source: "src/aion-web.roc"
  output: "aion-web"
}

task aion-shell {
  environment: "cli"
  run: [".kai/artifacts/aion-run", "shell"]
}

task import-image {
  environment: "cli"
  run: [".kai/artifacts/aion-run", "import-image"]
}

task status {
  environment: "cli"
  run: [".kai/artifacts/aion-run", "status"]
}

task resources {
  environment: "cli"
  run: [".kai/artifacts/aion-run", "resources"]
}

task image-status {
  environment: "cli"
  run: [".kai/artifacts/aion-run", "image-status"]
}

task image-reconcile {
  environment: "cli"
  run: [".kai/artifacts/aion-run", "image-reconcile"]
}

task create-demo {
  environment: "cli"
  run: [".kai/artifacts/aion-run", "create-demo"]
}

task shell-demo {
  environment: "cli"
  run: [".kai/artifacts/aion-run", "shell-demo"]
}

task shell-pi-demo {
  environment: "cli"
  run: [".kai/artifacts/aion-run", "shell-pi-demo"]
}

task check-demo {
  environment: "cli"
  run: [".kai/artifacts/aion-run", "check-demo"]
}

task destroy-demo {
  environment: "cli"
  run: [".kai/artifacts/aion-run", "destroy-demo"]
}

task delete-image {
  environment: "cli"
  run: [".kai/artifacts/aion-run", "delete-image"]
}

task payment-preflight {
  environment: "web"
  run: [".kai/artifacts/aion-run", "payment-preflight"]
}

task payment-server {
  environment: "web"
  run: [".kai/artifacts/aion-run", "payment-server"]
}

environment agent {
  packages: ["git", "pi-coding-agent"]
}

service aion {
  artifact: "aion-init"
}

machine agent {
  environment: agent
  system: "x86_64-linux"
  users: ["aion"]
  services: ["aion"]
}

workflow aion-shell {
  steps: ["build aion", "build aion-run", "run aion-shell"]
}

workflow prepare {
  steps: ["build aion", "build aion-run", "image agent"]
}

workflow import-image {
  steps: ["build aion", "build aion-run", "image agent", "run import-image", "run image-status"]
}

workflow payment-demo {
  steps: ["build aion", "build aion-run", "build aion-web", "run payment-preflight", "run payment-server"]
}
