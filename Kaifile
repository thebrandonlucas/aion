environment roc {
  packages: ["rocpkgs.nightly", "llvmPackages.bintools", "nix"]
  overlays: ["github:thebrandonlucas/roc-overlay"]
}

task format {
  environment: "roc"
  run: ["roc", "fmt", "plugins/aion/AionPlugin.roc", "src/aion-init.roc", "src/aion.roc", "src/AionState.roc", "src/DigitalOcean.roc", "src/DigitalOceanApi.roc"]
}

environment cli {
  packages: ["rocpkgs.nightly", "llvmPackages.bintools", "openssh", "coreutils", "awscli2"]
  overlays: ["github:thebrandonlucas/roc-overlay"]
}

build aion {
  environment: cli
  source: "src/aion.roc"
  output: "aion"
}

build aion-init {
  environment: roc
  source: "src/aion-init.roc"
  output: "aion-init"
}

workflow prepare {
  steps: ["build aion-init", "build aion", "machine-build agent"]
}

aion-machine agent {
  system: "x86_64-linux"
  region: "nyc3"
  size: "s-2vcpu-4gb"
  provider: "ppq"
  model: "openai/gpt-5.1-codex"
  packages: ["git"]
}
