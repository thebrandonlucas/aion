environment bootstrap {
  packages: ["rocpkgs.nightly", "llvmPackages.bintools", "nix"]
  overlays: ["github:thebrandonlucas/roc-overlay"]
}

task format-plugin {
  environment: "bootstrap"
  run: ["roc", "fmt", "plugins/aion/AionBuildPlugin.roc"]
}

task bootstrap-kai {
  environment: "bootstrap"
  run: ["nix", "run", "github:thebrandonlucas/kai/master#xkai", "--", "build", "plugins/aion/AionBuildPlugin.roc"]
}
